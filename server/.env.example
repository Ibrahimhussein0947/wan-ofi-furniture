# ---- Core ----
NODE_ENV=development
PORT=5050
# Local: mongodb://127.0.0.1:27017/wanofi?replicaSet=rs0   Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/wanofi
MONGO_URI=mongodb://127.0.0.1:27017/wanofi
CLIENT_URL=http://localhost:5174

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
# lax for same-site deployments, none when client and API are on different domains (requires HTTPS)
COOKIE_SAMESITE=lax

# ---- File storage ----
# local | s3   (s3 works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO)
STORAGE_DRIVER=local
MAX_UPLOAD_MB=5
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Public URL of the web app, used in email links (defaults to the first CLIENT_URL)
APP_URL=

# ---- Email: console (prints to the log) | smtp ----
EMAIL_DRIVER=console
EMAIL_FROM=Wan Ofi Furniture <no-reply@wanofi.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- SMS: console | africastalking (use AT_USERNAME=sandbox for testing) ----
SMS_DRIVER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Telegram alerts: console | bot ----
# Create a bot with @BotFather, then point its webhook at
#   https://<your-domain>/api/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
# Users connect their account from Profile → Notifications.
TELEGRAM_DRIVER=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- WhatsApp alerts (Meta WhatsApp Cloud API): console | cloud ----
# Needs a WhatsApp Business account and an approved message template with two body
# variables: {{1}} = title, {{2}} = details. Users opt in from Profile → Notifications.
WHATSAPP_DRIVER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=wanofi_update
WHATSAPP_TEMPLATE_LANG=en

# ---- Online payments: manual | sandbox (simulated, dev only) | chapa ----
# Chapa (Ethiopia) covers Telebirr, CBE Birr, Amole, M-PESA and Bybils.
# Register this callback URL in the Chapa portal:
#   https://<api-host>/api/payments/webhooks/chapa/<PAYMENT_WEBHOOK_SECRET>
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=
CHAPA_ENV=sandbox
CHAPA_APP_NAME=
CHAPA_CLIENT_ID=
CHAPA_CLIENT_SECRET=
CHAPA_API_KEY=

# ---- Seed (development only) ----
SEED_DEFAULT_PASSWORD=Password123!

# ---- Background jobs ----
ENABLE_CRON=true
